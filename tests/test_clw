def test_auxiliary_channels_matched():
    """v1.2 requirement: the common-mode families must not leak through o."""
    assert np.allclose(G.DELTA_RANGE[6], G.DELTA_RANGE[0])
    assert np.allclose(G.DELTA_RANGE[7], G.DELTA_RANGE[0])
    assert G.MBAR[6] == G.MBAR[0] and G.MBAR[7] == G.MBAR[0]


def test_no_severity_separation(prepared):
    d = prepared
    m0 = d["mission"][d["family"] == 0]
    m67 = d["mission"][np.isin(d["family"], [6, 7])]
    # the v1.1 defect was zero overlap; require substantial overlap now
    assert m0.max() > m67.min()
    overlap = np.mean((m67 >= m0.min()) & (m67 <= m0.max()))
    assert overlap > 0.9


# ---------------------------------------------------------------- assurance
def test_states_are_valid_density_operators(prepared):
    rho_i, rho = prepared["rho_i"], prepared["rho"]
    for R in (rho_i.reshape(-1, 5, 5), rho):
        assert np.allclose(R, np.swapaxes(R, -1, -2), atol=1e-12)
        assert np.allclose(np.trace(R, axis1=-2, axis2=-1), 1.0, atol=1e-10)
        assert (np.linalg.eigvalsh(R) > 0).all()


def test_lemma1_eigenvalue_floor(prepared):
    lo = A.EPS / (1.0 + A.EPS * A.D)
    w = np.linalg.eigvalsh(prepared["rho_i"].reshape(-1, 5, 5))
    assert w.min() >= lo - 1e-12


def test_functional_ranges(prepared):
    rho, env = prepared["rho"], prepared["envelope"]
    S = A.von_neumann_entropy(rho)
    g = A.purity(rho)
    F = A.root_fidelity(rho, env)
    D = A.relative_entropy(rho, env)
    J = A.bipartite_score(prepared["rho_i"])
    C = A.centred_alignment(prepared["evidence"])
    assert (S >= -1e-9).all() and (S <= np.log(A.D) + 1e-9).all()
    assert (g >= 1 / A.D - 1e-9).all() and (g <= 1 + 1e-9).all()
    assert (F >= -1e-9).all() and (F <= 1 + 1e-6).all()
    assert (D >= -1e-9).all()
    assert (J >= -1e-9).all() and (J <= 2 * np.log(A.D) + 1e-9).all()
    assert (C >= -1 - 1e-9).all() and (C <= 1 + 1e-9).all()


def test_bipartite_marginals_closed_form(prepared):
    """Gamma_A = beta rho1 + (1-beta) I/d must match the partial trace."""
    r = prepared["rho_i"][:20]
    d2 = A.D * A.D
    kron = np.einsum("nij,nkl->nikjl", r[:, 0], r[:, 1]).reshape(-1, d2, d2)
    gamma = A.BETA * kron + (1 - A.BETA) * A._sigma_diag()
    ga = gamma.reshape(-1, A.D, A.D, A.D, A.D).trace(axis1=2, axis2=4)
    expected = A.BETA * r[:, 0] + (1 - A.BETA) * np.eye(A.D) / A.D
    assert np.allclose(ga, expected, atol=1e-12)


def test_gates_fitted_on_nominal_training_only(prepared):
    """The 98th-percentile gate must fire on ~2% of the fitting slice."""
    g = A.fit_gates(prepared["raw"], prepared["nom_train"])
    for k in A.STRUCTURAL + A.SCALAR:
        rate = np.mean(g["z"][k][prepared["nom_train"]] >= g["tau"][k])
        assert 0.005 <= rate <= 0.045, (k, rate)


