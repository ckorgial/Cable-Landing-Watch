    d = prepared
    g = A.fit_gates(d["raw"], d["nom_train"])
    gated, _ = P.gated_policies(g, d["delta_bar"], d["mission"], d["resensing"])
    assert np.all(gated["B5"][gated["B6"] == P.ACCEPT] == P.ACCEPT)


def test_union_gate_set_is_monotone(prepared):
    """Row-2 monotonicity: a record accepted under the union gate set passes
    every constituent gate.  Note this does NOT extend to the full cascades,
    because B7 uses a different row-1 re-sense trigger, so a record re-sensed
    by B7 may be accepted by B8.  The union is more conservative in its gate
    set, not in every branch."""
    d = prepared
    g = A.fit_gates(d["raw"], d["nom_train"])
    union = np.stack([g["z"][k] >= g["tau"][k]
                      for k in A.STRUCTURAL + A.SCALAR], axis=1).any(axis=1)
    for subset in (A.STRUCTURAL, A.SCALAR):
        sub = np.stack([g["z"][k] >= g["tau"][k] for k in subset], axis=1).any(axis=1)
        assert np.all(union[sub])          # any subset firing implies union firing
        assert not np.any(sub & ~union)


# ---------------------------------------------------------------- adversarial
def test_representation_probe_outputs_are_valid():
    """Probe outputs and classifier-derived TV lower bounds remain in valid ranges."""
    import json
    path = os.path.join(ROOT, "results", "adversarial_results.json")
    if not os.path.exists(path):
        pytest.skip("run scripts/build_publication.py first")
    adv = json.load(open(path))
    for fam in adv["probe"]["by_family"].values():
        for rep in fam.values():
            tv = rep["tv_lower_bound"]
            for ni, rej in zip(rep["ni_grid"], rep["rejection"]):
                # tv is a lower bound on the true TV, so the bound may only be
                # checked against the achieved point of the same estimator
                assert rej <= ni + 1.0 + 1e-9
                assert rej >= 0.0
            assert -1.0 <= tv <= 1.0


def test_structural_probe_exceeds_observation_probe():
    """The structural representation exposes greater separation to the same supervised probe."""
    import json
    path = os.path.join(ROOT, "results", "adversarial_results.json")
    if not os.path.exists(path):
        pytest.skip("run scripts/build_publication.py first")
    f7 = json.load(open(path))["probe"]["by_family"]["f7"]
    i = f7["obs"]["ni_grid"].index(0.10)
    assert f7["struct"]["rejection"][i] > f7["obs"]["rejection"][i] + 0.10
    assert f7["struct"]["tv_lower_bound"] > f7["obs"]["tv_lower_bound"]


def test_evasion_success_uses_full_cascade(prepared):
    """A2 success must include the severity row, not only row-2 gates."""
    d = prepared
    gates = A.fit_gates(d["raw"], d["nom_train"])
    r = ADV.attack_evasion(d, gates, 20260516, "B6c", eps=0.0, n_records=40, iters=0)
    ev = d["split"] == 2
    pool = np.flatnonzero(ev & (d["family"] == 7) & (d["prediction"] != d["truth"]))
    rng = np.random.default_rng(20260516 + 7)
    idx = rng.choice(pool, size=min(40, len(pool)), replace=False)
    keys, core, trig = P.POLICY_SETS["B6c"]
    z = {k: gates["z"][k][idx] for k in gates["z"]}
    u = {k: gates["u"][k][idx] for k in gates["u"]}
    gg = dict(z=z, tau=gates["tau"], u=u)
    act, _ = P.cascade(gg, list(keys), list(core), trig,
                       d["delta_bar"][idx], d["mission"][idx], d["resensing"][idx])
    assert abs(r["evaded_clean"] - np.mean(act == P.ACCEPT)) < 1e-12


def test_evasion_search_is_monotone_in_budget():
    import json
    path = os.path.join(ROOT, "results", "adversarial_results.json")
    if not os.path.exists(path):
        pytest.skip("run scripts/build_publication.py first")
    ev = json.load(open(path))["evasion"]
    for name, rows in ev.items():
        vals = [r["evaded_attacked"] for r in rows]
        assert all(a <= b + 1e-9 for a, b in zip(vals, vals[1:])), name
        assert rows[0]["evaded_attacked"] >= rows[0]["evaded_clean"] - 1e-9


def test_union_is_most_evasion_resistant():
    """The union is strictly hardest to evade at every budget.

    The structural-versus-scalar ordering is NOT monotone in the budget: at
    eps = 0.20 the compact structural set becomes easier to evade than the
    scalar set, because a large enough perturbation can satisfy four smooth
    constraints simultaneously.  The paper reports that crossing rather than
    asserting an ordering that does not hold.
    """
    import json
    path = os.path.join(ROOT, "results", "adversarial_results.json")
    if not os.path.exists(path):
        pytest.skip("run scripts/build_publication.py first")
    ev = json.load(open(path))["evasion"]
    for i in range(len(ADV_EPS)):
        assert ev["B8c"][i]["evaded_attacked"] < ev["B6c"][i]["evaded_attacked"]
        assert ev["B8c"][i]["evaded_attacked"] < ev["B7"][i]["evaded_attacked"]
    small = ADV_EPS.index(0.05)
    assert ev["B6c"][small]["evaded_attacked"] < ev["B7"][small]["evaded_attacked"]


