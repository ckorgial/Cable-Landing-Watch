    """The shipped compact set must equal the leave-one-seed-out selection."""
    assert tuple(sorted(P.COMPACT)) == ("C", "J", "S", "gf")


def test_union_is_dominated_on_the_frontier():
    """B8c attains lower HAR only at coverage where B6c is lower still."""
    import json
    path = os.path.join(ROOT, "results", "paper_results.json")
    if not os.path.exists(path):
        pytest.skip("run scripts/build_publication.py first")
    a = json.load(open(path))
    u = sorted(a["frontier"]["B8c"], key=lambda p: p["Cov"])
    c = sorted(a["frontier"]["B6c"], key=lambda p: p["Cov"])
    xs = [p["Cov"] for p in c]
    ys = [p["HAR"] for p in c]
    overlap = [p for p in u if xs[0] <= p["Cov"] <= xs[-1]]
    assert overlap, "no overlapping coverage range"
    for p in overlap:
        assert p["HAR"] >= np.interp(p["Cov"], xs, ys) - 1e-9


